{
  "name": "reader",
  "version": "0.0.4",
  "description": "A local two-pane reader/editor for a directory of markdown: rendered on the left, editable on the right, with asides set in a column of their own.",
  "type": "module",
  "bin": {
    "reader": "./bin/reader.js"
  },
  "scripts": {
    "start": "node bin/reader.js",
    "test": "node --test",
    "lint": "eslint .",
    "shots": "node scripts/shots.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "highlight.js": "^11.12.0",
    "markdown-it": "^15.0.3",
    "markdown-it-emoji": "^3.1.0"
  },
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.65.0"
  }
}
